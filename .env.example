# Node environment
NODE_ENV=development
LOG_LEVEL=debug

# Kafka / Redpanda
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=iot-platform
KAFKA_GROUP_ID_PREFIX=iot

# TimescaleDB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_dev_password
POSTGRES_DB=iot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CURATED=curated

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=iot-platform

# API
API_PORT=3000
JWT_SECRET=dev_jwt_secret_change_me
